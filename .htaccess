<FilesMatch "^(files_config\.json|zip_progress\.json)$">
    Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:app|tests|\.runtime|\.trash|\.shares)(?:/|$) - [F,L]
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "^(songs|manifest|[0-9]+|27-plus)\.json$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/json text/css application/javascript
</IfModule>
